    {
      "id": "Hkbva_9UwEKylPNb9wF9T",
      "type": "text",
      "x": 10219.843932632215,
      "y": -6212.645936688607,
      "width": 1906.518798828125,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9Vj8gs05MIkvVDhex_BEU"
      ],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 1870777346,
      "version": 895,
      "versionNonce": 1492723714,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792756752707,
      "created": 1792751681414,
      "link": null,
      "locked": false,
      "text": "Here is the exact low-level journey of a single ping to a Google IP (using simple IPv4 numbers like 8.8.8.8 so it is easy to track), from your\nkeyboard to Google and back.\n\nYour PC: IP 192.168.1.5 | MAC AA:AA\n\nYour Router (Inside Wi-Fi NIC): IP 192.168.1.1 | MAC BB:BB\n\nYour Router (Outside Fibre NIC): Public IP 49.205.10.20 | MAC CC:CC\n\nISP Router (Hop 2): IP 49.205.10.1 | MAC DD:DD\n\nGoogle Server (Hop 7): IP 8.8.8.8 | MAC GG:GG\n\n\n\n\n\n",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Cs0ADdUu_U2zCsPKCETLN",
      "originalText": "Here is the exact low-level journey of a single ping to a Google IP (using simple IPv4 numbers like 8.8.8.8 so it is easy to track), from your keyboard to Google and back.\n\nYour PC: IP 192.168.1.5 | MAC AA:AA\n\nYour Router (Inside Wi-Fi NIC): IP 192.168.1.1 | MAC BB:BB\n\nYour Router (Outside Fibre NIC): Public IP 49.205.10.20 | MAC CC:CC\n\nISP Router (Hop 2): IP 49.205.10.1 | MAC DD:DD\n\nGoogle Server (Hop 7): IP 8.8.8.8 | MAC GG:GG\n\n\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "m8ksAvB5jbyz-9dADzq09",
      "type": "rectangle",
      "x": 10169.214324477918,
      "y": -5447.645962119923,
      "width": 1996.6667938232422,
      "height": 920,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9Vj8gs05MIkvVDhex_BEU"
      ],
      "frameId": null,
      "index": "b0D",
      "roundness": {
        "type": 3
      },
      "seed": 518439390,
      "version": 1300,
      "versionNonce": 1163450306,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "gBqcxGKutsVlPQoYZ9bP5"
