      "text": "Communication between 2 devices on local network (mainly router and your pc)",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "6CtVMX1_HGjpg1Kn6nTf9",
      "originalText": "Communication between 2 devices on local network (mainly router and your pc)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Hg4Qh-p01WN0PXEp0g2qY",
      "type": "rectangle",
      "x": 2326.3036464692564,
      "y": -1209.2080219443283,
      "width": 608.8646883768153,
      "height": 810,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "l4rgD6k2Fk47Qza-Ai1_I"
      ],
      "frameId": null,
      "index": "adt",
      "roundness": {
        "type": 3
      },
      "seed": 923688194,
      "version": 629,
      "versionNonce": 2135579038,
      "isDeleted": false,
